{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-default",
      "displayName": "Linux (GCC 15, Unix Makefiles, Debug)",
      "description": "Повторяет то, что делает dev-контейнер: g++-15, Debug, каталог build/. Ninja в образ не ставится, поэтому генератор — Unix Makefiles. Перед первым запуском нужен `conan install . --build=missing --settings=build_type=Debug`, он и кладёт conan_toolchain.cmake по указанному ниже пути.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/Debug/generators/conan_toolchain.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows (MSVC x64, Ninja, Release)",
      "description": "Собирается через scripts\\build_windows.ps1: cl.exe берётся из окружения vcvars64, поэтому запускать этот пресет надо из developer-командной строки. Стандарт 23 — тот же, что и на Linux; отдельного режима C++26 у MSVC нет, самый новый у него /std:c++latest, и CMake отдаёт его под именем CXX23. Путь к conan_toolchain.cmake задан layout() из conanfile.py; скрипт всё равно передаёт найденный путь через -D, так что он главнее.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/windows/build/Release/generators/conan_toolchain.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "windows-msvc-release",
      "displayName": "Windows (MSVC x64, Ninja, Debug)",
      "description": "То же самое, но с Debug-информацией и отдельным каталогом, чтобы не перетирать Release.",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/windows-debug/build/Debug/generators/conan_toolchain.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-default",
      "configurePreset": "linux-default"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    }
  ],
  "testPresets": [
    {
      "name": "linux-default",
      "configurePreset": "linux-default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
